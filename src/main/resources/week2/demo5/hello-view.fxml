<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="week2.demo5.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>


    <Label fx:id="lblWeight" text="Weight" />
    <TextField fx:id="tfWeight"/>
    <Label fx:id="lblHeight" text="Height"/>
    <TextField fx:id="tfHeight"/>
    <Button fx:id="btnCalculate" text="btnCalculate" onAction="#onCalculateClick"/>
    <Label fx:id="lblResult"/>


    <Button text="EN!" onAction="#onENClick" />
    <Button text="FR!" onAction="#onFRClick" />
    <Button text="UR!" onAction="#onURClick" />
    <Button text="VI!" onAction="#onVIClick" />


</VBox>
